afficher("=== Valeurs simples ===");
afficher(42);
afficher(3.14);
afficher("Bonjour");
nombre a = 10;
nombre b = 3;
texte nom = "Baget";
afficher(a);
afficher(nom);

afficher("=== Priorités ===");
afficher(2 + 3 * 4);
afficher((2 + 3) * 4);
afficher(a + b * 2);
afficher((a + b) * 2);
afficher(2 * (3 + (4 - 1)));

afficher("=== Associativité ===");
afficher(10 - 3 - 2);
afficher(100 / 10 / 2);
afficher(2 * 3 * 4);

afficher("=== Division ===");
afficher(a / b);
afficher(7 / 2);
afficher(a / 0);
afficher(a / (b - 3));

afficher("=== Moins unaire ===");
afficher(-3);
afficher(-2 * 3);
afficher(5 - -2);
afficher(--4);
afficher(-a);
afficher(-(a + b));
afficher(-a * -b);
nombre negatif = -7.5;
afficher(negatif);
afficher(-negatif);

afficher("=== Textes ===");
afficher("Baget" + "Script");
afficher(nom + "Script");
texte phrase = "Bonjour " + nom;
afficher(phrase);
afficher(-"salut");
afficher(-"ça marche");
afficher(--nom);
afficher(-("abc" + "def"));
afficher(-"abc" + "def");

afficher("=== Variables calculées ===");
nombre c = (a + b) * 2 - 6;
afficher(c);
nombre d = c / 4 + -a;
afficher(d);

afficher("=== Fin : tout marche ! ===");