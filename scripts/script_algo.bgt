texte titre = "===== BAGETSCRIPT DEMO =====";
afficher(titre);

nombre i = 1;
nombre somme = 0;
nombre pairs = 0;
nombre impairs = 0;

tantque (i <= 20)
{
    afficher("----------------");
    afficher("Valeur : " + i);

    somme = somme + i;

    si ((i % 2) == 0)
    {
        afficher("Pair");

        pairs = pairs + 1;

        si (i >= 10)
        {
            afficher("Pair et >= 10");
        }
        sinon
        {
            afficher("Pair mais < 10");
        }
    }
    sinon
    {
        afficher("Impair");
        impairs = impairs + 1;
    }

    booleen multiple3 = ((i % 3) == 0);
    booleen multiple5 = ((i % 5) == 0);

    si(multiple3 && multiple5)
    {
        afficher("Multiple de 3 et 5");
    }
    sinon
    {
        si (multiple3)
        {
            afficher("Multiple de 3");
        }
        sinon
        {
            si (multiple5)
            {
                afficher("Multiple de 5");
            }
        }
    }

    si (!(i == 13))
    {
        afficher("Ce n'est pas 13");
    }
    sinon
    {
        afficher("Nombre porte-bonheur !");
    }

    i = i + 1;
}

afficher("=================");
afficher("FIN");

afficher("Somme = " + somme);
afficher("Pairs = " + pairs);
afficher("Impairs = " + impairs);

booleen verification = (pairs + impairs) == 20;

si (verification)
{
    afficher("Verification OK");
}
sinon
{
    afficher("Erreur de calcul");
}