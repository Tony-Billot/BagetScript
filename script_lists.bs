afficher("=== TEST LISTES COMPLET ===");

liste fruits = ["pomme", "banane", "kiwi"];
afficher("Initial: " + fruits);
afficher("Taille initiale: " + fruits.taille());

afficher("Index 0: " + fruits[0]);
afficher("Index 2: " + fruits[2]);

fruits[1] = "mangue";
afficher("Apres fruits[1] = mangue: " + fruits);

fruits.ajouter("orange");
afficher("Apres ajouter orange: " + fruits);
afficher("Taille apres ajouter: " + fruits.taille());

texte retire = fruits.retirer(0);
afficher("Element retire index 0: " + retire);
afficher("Apres retirer(0): " + fruits);
afficher("Taille finale: " + fruits.taille());

afficher("Iteration avec pour (x dans fruits):");
pour (x dans fruits)
{
    afficher("- " + x);
}

entier dernier = fruits.taille() - 1;
afficher("Iteration avec index:");
pour (i allant de 0 a dernier)
{
    afficher("fruits[" + i + "] = " + fruits[i]);
}
